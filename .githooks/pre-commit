#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
CONFIG="$ROOT/.githooks/config"
if [[ -f "$CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG"
fi
if [[ "${SKIP_QUESTSHIFT_HOOKS:-}" == "1" ]]; then
    echo "questshift-campaigns pre-commit: skipped (SKIP_QUESTSHIFT_HOOKS=1)"
    exit 0
fi
if ! git diff --cached --name-only --diff-filter=ACMR | grep -Eq '\.(ya?ml|py|toml)$|^campaigns/|^\.githooks/|^verify\.sh$'; then
    exit 0
fi
echo "questshift-campaigns pre-commit: yamllint, ruff, coverage"
./verify.sh
